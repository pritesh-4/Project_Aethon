# ==============================================================================
# AETHON — Backend Service Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# This file contains private server-side configuration. Do not place real production
# credentials in this example file.
#
# To customize local backend settings, copy this file to `backend/.env`:
#   Windows PowerShell: Copy-Item backend\.env.example backend\.env
#   macOS / Linux:      cp backend/.env.example backend/.env
# ==============================================================================

# Core Application Metadata
APP_NAME="AETHON Radio Signal Discovery API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server Networking
HOST="127.0.0.1"
PORT=8000

# API Routing
API_PREFIX="/api"

# CORS Configuration (JSON array or comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Application Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Storage, Ingestion, and Slice Bounds Configuration
DATA_DIR="data"
OBSERVATIONS_DIR="data/observations"
TEMP_UPLOAD_DIR="data/tmp"
DB_PATH="data/aethon.db"
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_SLICE_CELLS=250000

# ==============================================================================
# Security & Cryptographic Placeholders (Future Features - Currently Optional)
# ==============================================================================
# Optional cryptographic secret key for future authentication / signed dossier verification.
# When omitted, cryptographic operations are disabled or use secure local defaults.
# SECRET_KEY=

# ==============================================================================
# External Astronomical Archives & Integrations (Roadmap Features - Currently Optional)
# ==============================================================================
# Optional directory for caching Astropy catalog and ephemeris queries (SIMBAD, Gaia)
# ASTROPY_CACHE_DIR=

# Remote URL for Breakthrough Listen public open-data repository
BREAKTHROUGH_LISTEN_ARCHIVE_URL="https://seti.berkeley.edu/opendata"
BREAKTHROUGH_LISTEN_MAX_IMPORT_BYTES=83886080
BREAKTHROUGH_LISTEN_TIMEOUT_SECONDS=20
BREAKTHROUGH_LISTEN_CATALOG_CACHE_SECONDS=300

# Optional API key for remote astronomical services (leave empty if unauthenticated)
BREAKTHROUGH_LISTEN_API_KEY=""
