# ==============================================================================
# AETHON — Frontend Environment Configuration (Vite)
# ==============================================================================
# SECURITY NOTICE:
# Any variable prefixed with VITE_ is embedded directly into client-side browser
# JavaScript bundles during build or development.
#
# NEVER put private server secrets, database credentials, internal tokens, or
# private API keys in this file or any .env file consumed by Vite.
#
# To customize local frontend settings, copy this file to `.env.local`:
#   Windows PowerShell: Copy-Item .env.example .env.local
#   macOS / Linux:      cp .env.example .env.local
# ==============================================================================

# Backend REST API endpoint for scientific discovery & candidate ingestion
# Must point to the running AETHON FastAPI service.
VITE_API_BASE_URL=http://localhost:8000/api

# Operational mode: Set to "true" for standalone offline demonstration mode.
# When "false" (default), the interface makes real requests to the FastAPI backend.
VITE_DEMO_MODE=false

# Optional: Observatory telemetry stream WebSocket endpoint (future real-time stream)
VITE_TELEMETRY_WS_URL=ws://localhost:8000/ws/telemetry
