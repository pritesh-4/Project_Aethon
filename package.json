{
  "name": "aethon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit:offline": "node --experimental-strip-types --test tests/functional_correctness_and_ui_truthfulness.test.ts tests/api_client.test.ts tests/demo_datasets.test.ts tests/public_datasets_client.test.ts",
    "test:unit": "npm run test:unit:offline",
    "test:integration": "node --experimental-strip-types --test tests/connectivity.test.ts tests/browser_e2e_acceptance.test.ts",
    "test:e2e": "node --experimental-strip-types --test tests/browser_e2e_acceptance.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.2",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
